# RUN: not --crash llc -mtriple=amdgpu9.50 -run-pass=none -verify-machineinstrs -o /dev/null %s 2>&1 | FileCheck %s

---
name: partially_overlapping
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7_vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15, $vgpr20_vgpr21_vgpr22_vgpr23
    ; CHECK: Untied TiedMayBeDisjoint operands must not partially overlap
    early-clobber $vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7_vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15_vgpr16_vgpr17 = V_MFMA_F32_32X32X16_BF16_vgprcd_e64 $vgpr20_vgpr21_vgpr22_vgpr23, $vgpr20_vgpr21_vgpr22_vgpr23, $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7_vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15, 0, 0, 0, implicit $mode, implicit $exec
    %0:vreg_512_align2 = IMPLICIT_DEF
    %1:vreg_128_align2 = IMPLICIT_DEF
    ; CHECK: Tied def of a TiedMayBeDisjoint operand must not be early-clobber
    early-clobber %2:vreg_512_align2 = V_MFMA_F32_32X32X16_BF16_vgprcd_e64 %1, %1, %0(tied-def 0), 0, 0, 0, implicit $mode, implicit $exec
    S_ENDPGM 0
...
